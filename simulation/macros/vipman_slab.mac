# Paths (release v1.1.0): the aliases below are read from environment variables,
# set by simulation/runner/paths.sh or by hand. See simulation/README.md.
/control/getEnv PLI_GATE_MATERIALS_DB
/control/getEnv PLI_SCANNER_MACRO
/control/getEnv PLI_VIPMAN_DIR
# ==============================================================================
# VIPman voxelized multi-organ phantom — Sc-44 PLI simulation (1.4B, Poisson)
# ==============================================================================
#
# Phase 3q production sim. Same recipe as Phase 3p-2 50M smoketest, scaled to
# 1.4B primaries. Pipeline: GATE → ROOT → HDF5 → bg generate → inject → h5
# extract → simple_recon. Run as 32 sequential batches × 16 threads via
# scripts/run_gate_parallel_musire.sh, called from
# reconstruction/utils/run_phase3q_per_batch.py.
#
# Diff from macros/vipman_sc44_50M_poisson.mac:
#   * CHANGED  /gate/application/setTimeStop 0.956 → 0.0523 s (per-shard slice;
#              0.0523 × 16 threads × 32 batches = 26.77 s total = 1.4B at 52.29 MBq)
#
# The runner divides --total-time-sec by --threads to get per-shard time.
# The macro's setTimeStop here is the per-SHARD value used inside one thread.
# 32 sequential batches × 16 threads × 0.0523 s/shard = 26.77 s simulated
# total = 1.4 × 10⁹ Sc-44 decays at 52.29 MBq atlas.
# ==============================================================================

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# ── Materials ──────────────────────────────────────────────────────────────
/gate/geometry/setMaterialDatabase {PLI_GATE_MATERIALS_DB}

# ── Scanner (Biograph Vision Quadra) ───────────────────────────────────────
/control/execute {PLI_SCANNER_MACRO}

# ── Phantom: VIPman voxelized atlas ────────────────────────────────────────
/gate/world/daughters/name                          vipman
/gate/world/daughters/insert                        ImageNestedParametrisedVolume
/gate/vipman/geometry/setImage                      {PLI_VIPMAN_DIR}/vipman-atlas-lungs-32mm-1mm-cropped-fixed.mhd
/gate/vipman/geometry/setRangeToMaterialFile        {PLI_VIPMAN_DIR}/vipman-atlas-gate-materials.dat
/gate/vipman/placement/setTranslation               0 0 0 mm

# ── Physics ────────────────────────────────────────────────────────────────
/gate/physics/addPhysicsList PLI_Physics
/gate/physics/Gamma/SetCutInRegion    world 1 mm
/gate/physics/Electron/SetCutInRegion world 1 mm
/gate/physics/Positron/SetCutInRegion world 1 mm

# ── Initialize ─────────────────────────────────────────────────────────────
/gate/run/initialize

# ── Digitizer ──────────────────────────────────────────────────────────────
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert adder
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert readout
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/readout/setDepth 1
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert energyResolution
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/energyResolution/fwhm 0.101
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/energyResolution/energyOfReference 511 keV
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert timeResolution
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/timeResolution/fwhm 214 ps
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert energyFraming
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/energyFraming/setMin 350 keV
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/energyFraming/setMax 1300 keV

/gate/digitizerMgr/CoincidenceSorter/Coincidences/setWindow 20. ns
/gate/digitizerMgr/CoincidenceSorter/Coincidences/setOffset 0 ns

# ── Source: Sc-44 ion driven by VIPman activity map (Poisson timing) ──────
/gate/source/addSource                              vox voxel
/gate/source/vox/reader/insert                      image
/gate/source/vox/imageReader/translator/insert      range
/gate/source/vox/imageReader/rangeTranslator/readTable {PLI_VIPMAN_DIR}/vipman-atlas-gate-activities-f18-fdg.dat
/gate/source/vox/imageReader/readFile               {PLI_VIPMAN_DIR}/vipman-atlas-lungs-32mm-1mm-cropped-fixed.mhd
/gate/source/vox/setPosition                        -280.5 -135.5 -16 mm
/gate/source/vox/gps/particle                       ion
/gate/source/vox/gps/ion                            21 44 0 0
/gate/source/vox/gps/ene/type                       Mono
/gate/source/vox/gps/ene/mono                       0 keV
/gate/source/vox/gps/ang/type                       iso
# Phase 3p-2: setForcedUnstableFlag + setForcedHalfLife REMOVED for Poisson
# timing per Phase 3c recipe. Per-voxel activity from .dat drives the Poisson
# process directly.

# Force fast Sc-44 decay (overrides PDGLifeTime ~14292 s).
/particle/select Sc44
/particle/property/stable false
/particle/property/lifetime 0.001 ns

# ── Output ─────────────────────────────────────────────────────────────────
/gate/output/root/enable
/gate/output/root/setFileName vipman_sc44_1400M_poisson
/gate/output/root/setRootHitFlag 0
/gate/output/root/setRootSinglesFlag 1
/gate/output/root/setRootCoincidencesFlag 1

# ── Run ────────────────────────────────────────────────────────────────────
# Phase 3q: setTimeStop 0.0523 s per-shard.
# 0.0523 × 16 threads × 32 batches = 26.77 s total = 1.4B Sc-44 decays at 52.29 MBq.
/gate/application/setTimeStart 0.0 s
/gate/application/setTimeStop  0.0523 s
/gate/application/setTimeSlice 1.0 s

/gate/random/setEngineName MersenneTwister
/gate/random/setEngineSeed auto
# Note: runner overrides seed to 1_000_000 + batch_id × 1000 + thread_id
# per Phase 3q-design seed scheme.

/gate/application/start
