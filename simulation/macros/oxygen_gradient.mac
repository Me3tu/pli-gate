# Paths (release v1.1.0): the aliases below are read from environment variables,
# set by simulation/runner/paths.sh or by hand. See simulation/README.md.
/control/getEnv PLI_SIM
/control/getEnv PLI_SCANNER_MACRO
# Review round 8 oxygen rerun (database v8); copy of the Phase 3s-2 hypoxia te master mac

# ==============================================================================
# Hypoxia gradient phantom simulation — Phase 3.4
# ==============================================================================
#
# Runs the 5-insert hypoxia gradient phantom through GATE with the
# new TE + O2 physics list. Oracle log carries per-insert material names
# so parse_sanity_log.py can fit per-region tau; ROOT output for Phase 4
# CASToR reconstruction.
#
# The TE+O2 arm produces ~3 ps total spread across the 5 regions; the
# lookup arm produces a flat 1.85 ns for all 5 regions (old physics had
# no pO2 dependence). Both arms should reconstruct to visually flat
# lifetime maps at the Quadra's 214 ps CRT — that flatness IS the
# paper's quantitative negative result.
#
# Source: Sc-44 uniform in the water body (reuses the multi-tissue
# phantom's pattern — primaries spawn anywhere in the cylinder, land in
# whichever daughter contains the position).
# ==============================================================================

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# Materials
/gate/geometry/setMaterialDatabase {PLI_SIM}/geometry/materials_pli.db

# Scanner (Quadra)
/control/execute {PLI_SCANNER_MACRO}

# Phantom: water body + 5 hypoxia variant inserts
/control/execute {PLI_SIM}/geometry/phantom_hypoxia_gradient.mac

# Sensitive-detector attachment (NEMA pattern)
/gate/phantom/attachPhantomSD
/gate/insert_pO2_2/attachPhantomSD
/gate/insert_pO2_6/attachPhantomSD
/gate/insert_pO2_10/attachPhantomSD
/gate/insert_pO2_20/attachPhantomSD
/gate/insert_pO2_40/attachPhantomSD

# Physics
/gate/physics/addPhysicsList PLI_Physics
/gate/physics/Gamma/SetCutInRegion    world 1 mm
/gate/physics/Electron/SetCutInRegion world 1 mm
/gate/physics/Positron/SetCutInRegion world 1 mm

# Initialize
/gate/run/initialize

# Digitizer: Biograph Vision Quadra (same as Phase 3.1 — Sc-44 window)
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert adder
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert readout
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/readout/setDepth 1
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert energyResolution
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/energyResolution/fwhm 0.101
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/energyResolution/energyOfReference 511 keV
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert timeResolution
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/timeResolution/fwhm 214 ps
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/insert energyFraming
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/energyFraming/setMin 435 keV
/gate/digitizerMgr/LSO/SinglesDigitizer/Singles/energyFraming/setMax 1300 keV

/gate/digitizerMgr/CoincidenceSorter/Coincidences/setWindow 20. ns
/gate/digitizerMgr/CoincidenceSorter/Coincidences/setOffset 0 ns

# Source: Sc-44, uniform in water cylinder
/control/execute {PLI_SIM}/sources/scandium44_uniform_poisson.mac

# Force instant Sc-44 decay
/particle/select Sc44
/particle/property/stable false
/particle/property/lifetime 0.001 ns

# Output: ROOT for CASToR reconstruction
/gate/output/root/enable
/gate/output/root/setFileName hypoxia_te_v8
/gate/output/root/setRootHitFlag 0
/gate/output/root/setRootSinglesFlag 1
/gate/output/root/setRootCoincidencesFlag 1

# Run
/gate/application/setTimeStart 0.0 s
/gate/application/setTimeStop  3.906250 s
/gate/application/setTimeSlice 1.0 s

/gate/random/setEngineName MersenneTwister
/gate/random/setEngineSeed auto

/gate/application/start
